# Ensure the logs stream works properly
@router.get("/logs/stream")
async def stream_engine_logs(request: Request, user_id: int = Depends(require_admin)):
    """SSE endpoint for live real uvicorn system logs."""
    # Use absolute path
    import os
    project_root = os.path.abspath(os.path.join(os.path.dirname(__file__), "../../../../../"))
    log_file = os.path.join(project_root, "storage/logs/uvicorn.log")

    async def log_generator():
        if not os.path.exists(log_file):
            yield "data: [SYSTEM] Log file not found. Waiting for logs...\n\n"
            # Keep connection open and retry
            while not await request.is_disconnected():
                if os.path.exists(log_file):
                    break
                await asyncio.sleep(1)
            if await request.is_disconnected():
                return
        
        with open(log_file, "r") as f:
            # Start from the end
            f.seek(0, os.SEEK_END)
            # Send last 20 lines for context
            f.seek(max(0, f.tell() - 4096))
            lines = f.readlines()
            for line in lines[-25:]:
                yield f"data: {line.strip()}\n\n"
            
            while not await request.is_disconnected():
                line = f.readline()
                if line == "":
                    await asyncio.sleep(0.5)
                    continue
                yield f"data: {line}\n\n"
    
    return StreamingResponse(log_generator(), media_type="text/event-stream")
