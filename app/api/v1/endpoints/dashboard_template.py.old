"""
UI Template for the PersonaVault Admin Dashboard.
Full-featured dashboard with all capabilities restored.
"""

DASHBOARD_HTML = """
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PersonaVault Admin</title>
    <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --accent: #38bdf8; --bg: #0f172a; --card-bg: #1e293b; --sidebar: #111827; --border: #334155; --success: #34d399; --warning: #fbbf24; --danger: #f87171; }
        * { box-sizing: border-box; }
        body { font-family: 'Inter', -apple-system, sans-serif; background: var(--bg); color: #f1f5f9; margin: 0; padding: 0; display: flex; flex-direction: column; height: 100vh; overflow: hidden; }
        header { background: var(--card-bg); display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding: 15px 30px; z-index: 10; flex-shrink: 0; }
        h1 { color: #38bdf8; margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -0.025em; }
        .layout { display: flex; flex: 1; overflow: hidden; }
        .sidebar { width: 260px; background: var(--sidebar); border-right: 1px solid var(--border); display: flex; flex-direction: column; padding-top: 20px; overflow-y: auto; flex-shrink: 0; }
        .nav-group { margin-bottom: 25px; }
        .nav-label { padding: 0 30px; font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 10px; }
        .nav-item { padding: 12px 30px; cursor: pointer; color: #94a3b8; font-size: 14px; transition: all 0.2s; border-left: 3px solid transparent; display: flex; align-items: center; gap: 10px; }
        .nav-item:hover { background: rgba(56, 189, 248, 0.05); color: #f1f5f9; }
        .nav-item.active { background: rgba(56, 189, 248, 0.1); color: var(--accent); border-left-color: var(--accent); font-weight: 600; }
        .main-content { flex: 1; overflow-y: auto; padding: 40px; }
        .tab-content { display: none; animation: fadeIn 0.3s ease-out; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 25px; margin-bottom: 40px; }
        .card { background: var(--card-bg); border-radius: 12px; padding: 25px; border: 1px solid var(--border); transition: transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); }
        .card:hover { transform: translateY(-2px); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2); }
        .card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .card-title { font-size: 14px; font-weight: 700; color: var(--accent); text-transform: uppercase; margin: 0; }
        .metric-value { font-size: 36px; font-weight: 800; color: #fbbf24; margin: 10px 0; }
        .metric-label { color: #94a3b8; text-transform: uppercase; font-size: 12px; font-weight: 600; letter-spacing: 0.05em; }
        .tag { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; background: var(--border); color: #f1f5f9; }
        .tag-success { background: #065f46; color: #34d399; }
        .tag-warning { background: #78350f; color: #fbbf24; }
        .tag-danger { background: #7f1d1d; color: #f87171; }
        .btn { display: inline-flex; align-items: center; gap: 8px; background: var(--accent); color: #0f172a; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: 700; border: none; cursor: pointer; transition: all 0.2s; }
        .btn:hover { background: #7dd3fc; }
        .btn-danger { background: #dc2626; color: white; }
        .btn-danger:hover { background: #ef4444; }
        .refresh-btn { cursor: pointer; color: var(--accent); background: transparent; border: 1px solid var(--accent); padding: 8px 16px; border-radius: 6px; font-weight: 600; transition: all 0.2s; }
        .refresh-btn:hover { background: rgba(56, 189, 248, 0.1); }
        pre { background: #020617; padding: 20px; border-radius: 8px; color: var(--accent); border: 1px solid var(--border); line-height: 1.5; white-space: pre-wrap; word-break: break-all; font-size: 13px; max-height: 400px; overflow: auto; }
        .input-field { width: 100%; padding: 10px; margin: 10px 0; border-radius: 4px; border: 1px solid #334155; background: #020617; color: white; box-sizing: border-box; }
        .mem-viz-container { margin-top: 15px; background: #020617; border-radius: 6px; height: 14px; display: flex; overflow: hidden; border: 1px solid var(--border); }
        .viz-l1 { background: #fbbf24; height: 100%; transition: width 0.6s ease-in-out; }
        .viz-l2 { background: #38bdf8; height: 100%; transition: width 0.6s ease-in-out; }
        .viz-l3 { background: #a855f7; height: 100%; transition: width 0.6s ease-in-out; }
        .viz-legend { display: flex; gap: 20px; margin-top: 10px; font-size: 11px; color: #94a3b8; }
        .log-container { background: #020617; flex-grow: 1; overflow-y: auto; padding: 15px; border-radius: 8px; font-family: monospace; font-size: 11px; border: 1px solid var(--border); white-space: pre-wrap; line-height: 1.4; max-height: 500px; }
        .log-line-error { color: #f87171; }
        .log-line-warning { color: #fbbf24; }
        .log-line-info { color: #38bdf8; }
        .flex-between { display: flex; justify-content: space-between; align-items: center; }
        .stat-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
        .stat-row:last-child { border-bottom: none; }
        .stat-label { color: #94a3b8; }
        .stat-value { color: #f1f5f9; font-weight: 600; font-family: monospace; }
        .pack-card { background: var(--card-bg); border-radius: 8px; padding: 15px; border-left: 4px solid var(--accent); margin-bottom: 10px; }
        .pack-card .pack-name { font-weight: 700; color: var(--accent); }
        .pack-card .pack-stats { font-size: 12px; color: #94a3b8; }
        .pack-card .pack-trend { font-size: 12px; font-weight: 600; }
        .modal { display: none; position: fixed; z-index: 2000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); backdrop-filter: blur(4px); }
        .modal-content { background: var(--card-bg); margin: 5% auto; padding: 30px; border: 1px solid var(--border); width: 85%; max-width: 900px; border-radius: 12px; position: relative; max-height: 85vh; overflow-y: auto; }
        .close-modal { position: absolute; top: 20px; right: 25px; color: #64748b; font-size: 28px; cursor: pointer; }
        .close-modal:hover { color: white; }
        .toast-container { position: fixed; bottom: 30px; right: 30px; z-index: 1000; display: flex; flex-direction: column; gap: 12px; }
        .toast { background: var(--card-bg); border: 1px solid var(--border); border-left: 4px solid var(--accent); padding: 14px 24px; border-radius: 8px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3); min-width: 280px; animation: slideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1); display: flex; align-items: center; gap: 12px; transition: all 0.3s; }
        @keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        .toast.success { border-left-color: var(--success); }
        .toast.error { border-left-color: var(--danger); }
        .toast.info { border-left-color: var(--accent); }
        .replay-controls { display: flex; gap: 10px; align-items: center; margin: 10px 0; }
        .replay-slider { flex: 1; accent-color: var(--accent); }
    </style>
</head>
<body>
    <header>
        <h1>🛡️ PersonaVault System Control</h1>
        <div style="display: flex; gap: 10px;">
            <button class="refresh-btn" onclick="fetchMetrics()"><i class="fas fa-sync-alt"></i> Refresh</button>
            <button class="refresh-btn" style="color: var(--danger); border-color: var(--danger);" onclick="logout()"><i class="fas fa-sign-out-alt"></i> Logout</button>
        </div>
    </header>
    
    <div class="layout">
        <nav class="sidebar">
            <div class="nav-group">
                <div class="nav-label">Core</div>
                <div class="nav-item active" onclick="switchTab(event, 'overview')">📊 System Overview</div>
                <div class="nav-item" onclick="switchTab(event, 'models')">📦 Model Management</div>
                <div class="nav-item" onclick="switchTab(event, 'logs')">📜 System Logs</div>
            </div>
            <div class="nav-group">
                <div class="nav-label">Cognitive Architecture</div>
                <div class="nav-item" onclick="switchTab(event, 'lattices')">🕸️ Memory Lattices</div>
                <div class="nav-item" onclick="switchTab(event, 'learning')">⚡ Graduation Logic</div>
                <div class="nav-item" onclick="switchTab(event, 'agents')">🤖 Agent Orchestration</div>
            </div>
            <div class="nav-group">
                <div class="nav-label">Behaviour Packs</div>
                <div class="nav-item" onclick="switchTab(event, 'packs')">📦 Domain Intelligence</div>
                <div class="nav-item" onclick="switchTab(event, 'mcp')">🔌 MCP Registry</div>
            </div>
            <div class="nav-group">
                <div class="nav-label">Decision Intelligence</div>
                <div class="nav-item" onclick="switchTab(event, 'timeline')">⏱️ Decision Timeline</div>
                <div class="nav-item" onclick="switchTab(event, 'replay')">🔄 Decision Replay</div>
                <div class="nav-item" onclick="switchTab(event, 'trends')">📈 Trend Analysis</div>
            </div>
            <div class="nav-group">
                <div class="nav-label">Enterprise & Safety</div>
                <div class="nav-item" onclick="switchTab(event, 'governance')">⚖️ Governance & Audit</div>
                <div class="nav-item" onclick="switchTab(event, 'security')">🔐 Privacy Vault</div>
            </div>
        </nav>
        
        <main class="main-content">
            <!-- ========== OVERVIEW TAB ========== -->
            <div id="overview-tab" class="tab-content active">
                <div id="metrics-grid" class="grid"></div>
                <div class="card" style="margin-bottom: 25px; border-top: 4px solid #34d399;">
                    <h3 class="card-title">📊 Platform Summary</h3>
                    <div id="platform-summary" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px; margin-top: 15px;">
                        <div><div class="metric-label">Domains</div><div id="domain-count" class="metric-value" style="font-size: 28px;">0</div></div>
                        <div><div class="metric-label">Total Events</div><div id="event-count" class="metric-value" style="font-size: 28px;">0</div></div>
                        <div><div class="metric-label">Avg Confidence</div><div id="avg-confidence" class="metric-value" style="font-size: 28px;">0%</div></div>
                        <div><div class="metric-label">Overall Trend</div><div id="overall-trend" class="metric-value" style="font-size: 28px; color: #34d399;">📈</div></div>
                    </div>
                </div>
                <div class="card" style="margin-bottom: 25px; border-top: 4px solid #fbbf24;">
                    <h3 class="card-title">🧪 Laboratory & Simulation</h3>
                    <p style="color: #94a3b8; font-size: 13px;">Trigger virtual telemetry to test real-time monitoring and HITL triggers.</p>
                    <button class="btn" id="sim-btn" onclick="toggleSimulation()"><i class="fas fa-bolt"></i> Ignite IoT Simulation</button>
                </div>
                <h2 style="margin-top: 40px; color: #94a3b8; font-size: 14px; text-transform: uppercase;">Raw Intelligence Feed</h2>
                <pre id="raw-metrics">Fetching system state...</pre>
            </div>

            <!-- ========== MODELS TAB ========== -->
            <div id="models-tab" class="tab-content">
                <h2 style="color: var(--accent);">📦 Model Management</h2>
                <div class="card" style="margin-bottom: 25px;">
                    <h3 style="margin-top:0; color: #38bdf8;">Pull New Model</h3>
                    <div style="display: flex; gap: 10px;">
                        <input type="text" id="new-model-input" placeholder="e.g. llama3.2:3b" class="input-field" style="flex:1;">
                        <button class="btn" onclick="triggerModelPull()"><i class="fas fa-download"></i> Pull Model</button>
                    </div>
                    <div id="pull-status" style="margin-top: 15px; font-family: monospace; font-size: 11px; color: #fbbf24; white-space: pre-wrap;"></div>
                </div>
                <div class="card">
                    <h3 style="margin-top:0; color: #34d399;">Installed Models</h3>
                    <div id="models-list" style="display: flex; flex-direction: column; gap: 12px;">
                        <div class="metric-label">Loading models...</div>
                    </div>
                </div>
            </div>

            <!-- ========== LOGS TAB ========== -->
            <div id="logs-tab" class="tab-content">
                <h2 style="color: var(--accent);">📜 System Logs</h2>
                <div class="card" style="height: calc(100vh - 250px); display: flex; flex-direction: column;">
                    <div class="flex-between mb-10">
                        <h3 style="margin:0; color: #34d399;">Live Engine Logs</h3>
                        <button class="refresh-btn" onclick="document.getElementById('log-container').innerHTML = ''"><i class="fas fa-eraser"></i> Clear View</button>
                    </div>
                    <div id="log-container" class="log-container"></div>
                </div>
            </div>

            <!-- ========== LATTICES TAB ========== -->
            <div id="lattices-tab" class="tab-content">
                <h2 style="color: var(--accent);">🕸️ Memory Lattices</h2>
                <p style="color: #94a3b8; font-size: 14px; margin-bottom: 20px;">
                    Visualization of the conversion from Volatile Context (Gas) to Episodic Memory (Liquid) and Semantic Constraints (Ice).
                </p>
                <div class="card" style="margin-bottom: 25px; border-left: 4px solid #a855f7;">
                    <div class="metric-label">Memory Distribution Ratio</div>
                    <div class="mem-viz-container">
                        <div id="bar-l1" class="viz-l1" style="width: 10%"></div>
                        <div id="bar-l2" class="viz-l2" style="width: 50%"></div>
                        <div id="bar-l3" class="viz-l3" style="width: 10%"></div>
                    </div>
                    <div class="viz-legend">
                        <span><span style="color:#fbbf24;">●</span> Layer 1 (Gas) - Active</span>
                        <span><span style="color:#38bdf8;">●</span> Layer 2 (Liquid) - <span id="layer2-count">0</span></span>
                        <span><span style="color:#a855f7;">●</span> Layer 3 (Ice) - <span id="layer3-count">0</span></span>
                    </div>
                </div>
                <div class="grid">
                    <div class="card"><div class="metric-label">Layer 1 (Gas)</div><div class="metric-value">Active</div></div>
                    <div class="card"><div class="metric-label">Layer 2 (Liquid)</div><div id="layer2-card-count" class="metric-value">0</div></div>
                    <div class="card"><div class="metric-label">Layer 3 (Ice)</div><div id="layer3-card-count" class="metric-value">0</div></div>
                </div>
            </div>

            <!-- ========== LEARNING TAB ========== -->
            <div id="learning-tab" class="tab-content">
                <h2 style="color: var(--accent);">⚡ Graduation Logic</h2>
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Crystallization Engine</h3>
                        <span class="tag tag-success">ACTIVE</span>
                    </div>
                    <p style="color: #94a3b8; font-size: 13px;">Configure the background task that graduates Liquid memories into Semantic Ice.</p>
                    <div style="margin: 20px 0;">
                        <div class="flex-between"><span style="color: #94a3b8;">Batch Size</span><input type="number" id="input-batch-size" value="10" style="width: 80px; background: #020617; border: 1px solid var(--border); color: white; padding: 4px;"></div>
                        <div class="flex-between"><span style="color: #94a3b8;">Interval (Hours)</span><input type="number" step="0.1" id="input-interval" value="1.0" style="width: 80px; background: #020617; border: 1px solid var(--border); color: white; padding: 4px;"></div>
                    </div>
                    <div style="display: flex; gap: 10px;">
                        <button class="btn" style="flex:1; background:#334155; color:white;" onclick="saveLearningConfig()">Save</button>
                        <button class="btn" style="flex:2; background:#a855f7;" onclick="triggerLearning()"><i class="fas fa-crystal-ball"></i> Trigger Now</button>
                    </div>
                    <div id="learning-status" style="font-size: 11px; color: #94a3b8; margin-top: 12px; text-align: center;">Crystallization monitoring online.</div>
                </div>
            </div>

            <!-- ========== AGENTS TAB ========== -->
            <div id="agents-tab" class="tab-content">
                <h2 style="color: var(--accent);">🤖 Agent Orchestration</h2>
                <div class="grid">
                    <div class="card">
                        <div class="card-title">Cognitive Load</div>
                        <div id="agent-load-stats" class="mt-10"></div>
                    </div>
                    <div class="card">
                        <div class="card-title">Empathy & Tone</div>
                        <div id="empathy-stats" class="mt-10"></div>
                    </div>
                </div>
                <div class="card" style="margin-bottom: 25px; border-top: 4px solid var(--accent);">
                    <div class="card-title">Layer 1: Cognitive Blackboard</div>
                    <p style="color: #94a3b8; font-size: 12px; margin-bottom: 15px;">Real-time shared insights between agents.</p>
                    <div id="blackboard-feed" style="max-height: 200px; overflow-y: auto;">
                        <div class="metric-label">No active insights.</div>
                    </div>
                </div>
                <div class="card" style="margin-bottom: 25px; border-top: 4px solid var(--accent);">
                    <div class="card-title">Swarm Command Console</div>
                    <div style="display: flex; gap: 10px;">
                        <input type="text" id="swarm-query-input" placeholder="e.g. Analyze the memory patterns..." class="input-field" style="margin:0; flex:1;">
                        <button class="btn" onclick="triggerSwarm()"><i class="fas fa-play"></i> Ignite Swarm</button>
                    </div>
                </div>
                <div class="card" style="border-top: 4px solid #a855f7;">
                    <div class="card-title">Chain-of-Thought (CoT) Negotiation Swarm</div>
                    <div id="mermaid-graph-container" style="background: #020617; border-radius: 8px; padding: 20px; overflow-x: auto; min-height: 250px; display: flex; justify-content: center; align-items: center;">
                        <div class="metric-label">Awaiting negotiation signal...</div>
                    </div>
                    <div id="thought-log" style="background: #020617; border: 1px solid var(--border); border-radius: 8px; padding: 15px; margin-top: 15px; font-family: monospace; font-size: 12px; max-height: 200px; overflow-y: auto;">
                        <div style="color: #64748b; font-style: italic;">> Initialize Live Swarm Feed...</div>
                    </div>
                </div>
            </div>

            <!-- ========== PACKS TAB ========== -->
            <div id="packs-tab" class="tab-content">
                <h2 style="color: var(--accent);">📦 Domain Intelligence Packs</h2>
                <div id="packs-grid" class="grid"></div>
                <div class="card" style="margin-top: 20px; border-top: 4px solid var(--accent);">
                    <h3 class="card-title">📥 Install New Pack</h3>
                    <p style="color: #94a3b8; font-size: 13px;">Upload a behaviour_pack.yaml file</p>
                    <input type="file" id="pack-file-input" accept=".yaml,.yml" class="input-field">
                    <button class="btn" onclick="installPack()"><i class="fas fa-download"></i> Install Pack</button>
                    <div id="pack-install-status" style="margin-top: 15px; font-family: monospace; font-size: 11px; color: #fbbf24;"></div>
                </div>
            </div>

            <!-- ========== MCP TAB ========== -->
            <div id="mcp-tab" class="tab-content">
                <h2 style="color: var(--accent);">🔌 MCP Registry</h2>
                <div class="grid">
                    <div class="card">
                        <div class="card-title">Registered Nodes</div>
                        <div id="mcp-servers-list"></div>
                    </div>
                    <div class="card">
                        <div class="card-title">Available Tools</div>
                        <div id="mcp-tools-list"></div>
                    </div>
                    <div class="card" style="grid-column: span 2; border-top: 4px solid var(--success);">
                        <div class="card-title">MCP Protocol Tester</div>
                        <div style="display: flex; gap: 10px;">
                            <select id="mcp-test-tool" class="input-field" style="margin:0; flex:1;">
                                <option value="vault_search">vault_search</option>
                                <option value="vault_add">vault_add</option>
                                <option value="blackboard_post">blackboard_post</option>
                                <option value="get_empathy_context">get_empathy_context</option>
                            </select>
                            <input type="text" id="mcp-test-args" placeholder='{"query": "test"}' class="input-field" style="margin:0; flex:2;">
                            <button class="btn" onclick="executeMcpTest()">Run Tool Call</button>
                        </div>
                        <pre id="mcp-test-output" style="margin-top:15px; display:none;"></pre>
                    </div>
                </div>
            </div>

            <!-- ========== TIMELINE TAB ========== -->
            <div id="timeline-tab" class="tab-content">
                <h2 style="color: var(--accent);">⏱️ Decision Timeline</h2>
                <p style="color: #94a3b8; font-size: 14px; margin-bottom: 20px;">
                    Every decision captured in a 5-step timeline: Detection → Policy → AI → Decision → Audit
                </p>
                <div class="card">
                    <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                        <input type="number" id="timeline-event-id" placeholder="Event ID" class="input-field" style="flex:1;">
                        <button class="btn" onclick="fetchTimeline()"><i class="fas fa-search"></i> Load Timeline</button>
                        <button class="btn" style="background:#334155;" onclick="listEvents()"><i class="fas fa-list"></i> List Events</button>
                    </div>
                    <div id="timeline-list">
                        <div class="metric-label">Enter an Event ID and click Load Timeline.</div>
                    </div>
                </div>
            </div>

            <!-- ========== REPLAY TAB ========== -->
            <div id="replay-tab" class="tab-content">
                <h2 style="color: var(--accent);">🔄 Decision Replay</h2>
                <p style="color: #94a3b8; font-size: 14px; margin-bottom: 20px;">
                    Replay any decision at any point in time to see how policies would have changed.
                </p>
                <div class="card">
                    <div style="display: flex; gap: 10px;">
                        <input type="number" id="replay-event-id" placeholder="Event ID" class="input-field" style="flex:1;">
                        <button class="btn" onclick="replayDecision()"><i class="fas fa-play"></i> Replay</button>
                    </div>
                    <div id="replay-result" style="margin-top: 15px; display: none;">
                        <div class="replay-controls">
                            <button class="btn" style="padding:4px 12px; background:#334155;" onclick="replaySpeed(0.5)">0.5x</button>
                            <button class="btn" style="padding:4px 12px; background:#334155;" onclick="replaySpeed(1)">1x</button>
                            <button class="btn" style="padding:4px 12px; background:#334155;" onclick="replaySpeed(2)">2x</button>
                            <button class="btn" style="padding:4px 12px; background:#334155;" onclick="replaySpeed(4)">4x</button>
                            <span id="replay-speed-label" style="color:#94a3b8; font-size:12px;">Speed: 1x</span>
                        </div>
                        <pre id="replay-output"></pre>
                    </div>
                </div>
            </div>

            <!-- ========== TRENDS TAB ========== -->
            <div id="trends-tab" class="tab-content">
                <h2 style="color: var(--accent);">📈 Trend Analysis</h2>
                <div class="card">
                    <div style="display: flex; gap: 10px; margin-bottom: 15px;">
                        <select id="trend-domain" class="input-field" style="flex:1;">
                            <option value="incident_response">Security Intelligence</option>
                            <option value="compliance_review">Compliance Intelligence</option>
                            <option value="contract_review">Contract Intelligence</option>
                            <option value="procurement_decision">Procurement Intelligence</option>
                            <option value="underwriting_decision">Insurance Intelligence</option>
                            <option value="robot_decision">Robotics Intelligence</option>
                        </select>
                        <input type="number" id="trend-days" value="30" class="input-field" style="width: 100px;">
                        <button class="btn" onclick="fetchTrends()"><i class="fas fa-chart-line"></i> Analyze</button>
                    </div>
                    <div id="trend-result">
                        <div class="metric-label">Select a domain and click Analyze.</div>
                    </div>
                </div>
            </div>

            <!-- ========== GOVERNANCE TAB ========== -->
            <div id="governance-tab" class="tab-content">
                <h2 style="color: var(--accent);">⚖️ Governance & Audit</h2>
                <div class="card">
                    <div class="flex-between">
                        <h3 class="card-title">VeriLinkOS Execution Kernel</h3>
                        <button class="btn" id="verilink-toggle-btn" onclick="toggleVeriLinkMode()"><i class="fas fa-plug-circle-xmark"></i> Suppress Connection</button>
                    </div>
                    <p id="verilink-desc" style="color: #94a3b8; font-size: 12px; margin-top: 5px;">Currently in fail-soft mode.</p>
                </div>
                <div class="card">
                    <h3 class="card-title">Action Chain & VAP Receipts</h3>
                    <div id="audit-container" style="max-height: 400px; overflow-y: auto;">
                        <div class="metric-label">Loading audit trail...</div>
                    </div>
                </div>
            </div>

            <!-- ========== SECURITY TAB ========== -->
            <div id="security-tab" class="tab-content">
                <h2 style="color: var(--accent);">🔐 Privacy Vault</h2>
                <div class="card" id="security-status-card">
                    <div class="metric-label">Loading vault status...</div>
                </div>
            </div>
        </main>
    </div>

    <div id="toast-container" class="toast-container"></div>

    <div id="details-modal" class="modal">
        <div class="modal-content">
            <span class="close-modal" onclick="closeModal()">&times;</span>
            <h2 style="color: var(--accent); margin-top: 0;" id="modal-title">Details</h2>
            <div id="modal-body"></div>
        </div>
    </div>

    <script>
        let logSource = null;
        let ws = null;
        let currentHitlData = [];
        let replaySpeed = 1;
        let replayInterval = null;
        mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'loose' });

        // ============ TAB SWITCHING ============
        function switchTab(event, tabId) {
            document.querySelectorAll('.nav-item').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            event.currentTarget.classList.add('active');
            document.getElementById(tabId + '-tab').classList.add('active');
            if (tabId === 'logs') startLogStream();
            if (tabId === 'models') fetchInstalledModels();
            if (tabId === 'packs') fetchPacks();
            if (tabId === 'timeline') listEvents();
            if (tabId === 'trends') fetchTrends();
            if (tabId === 'agents') fetchAgentStatus();
            if (tabId === 'mcp') fetchMcpRegistry();
            if (tabId === 'governance') fetchGovernanceLogs();
            if (tabId === 'learning') fetchLearningConfig();
            if (tabId === 'security') fetchSecurityStatus();
            if (tabId === 'lattices') fetchMetrics();
        }

        // ============ TOAST ============
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            const icon = type === 'success' ? 'fa-circle-check' : (type === 'error' ? 'fa-triangle-exclamation' : 'fa-circle-info');
            toast.innerHTML = `<i class="fas ${icon}"></i> <span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(20px)';
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }

        // ============ LOGS ============
        function startLogStream() {
            if (logSource) logSource.close();
            const container = document.getElementById('log-container');
            container.innerHTML = '';
            logSource = new EventSource('/api/v1/admin/dashboard/logs/stream');
            logSource.onmessage = function(e) {
                const line = document.createElement('div');
                line.textContent = e.data;
                if (e.data.includes('ERROR')) line.className = 'log-line-error';
                else if (e.data.includes('WARNING')) line.className = 'log-line-warning';
                else if (e.data.includes('INFO')) line.className = 'log-line-info';
                container.appendChild(line);
                container.scrollTop = container.scrollHeight;
            };
            logSource.onerror = function() {
                container.innerHTML += '<div style="color:#f87171;">⚠️ Log stream disconnected. Reconnecting...</div>';
                setTimeout(startLogStream, 3000);
            };
        }

        // ============ WEBSOCKET ============
        function connectWebSocket() {
            if (ws) ws.close();
            const clientId = 'admin_' + Math.random().toString(36).substring(7);
            const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
            ws = new WebSocket(`${protocol}//${window.location.host}/api/v1/admin/dashboard/ws/${clientId}`);
            ws.onopen = () => console.log('✅ WebSocket connected');
            ws.onmessage = function(e) {
                try {
                    const data = JSON.parse(e.data);
                    if (data.type === 'thought_stream') appendThought(data.agent, data.content);
                    else if (data.type === 'agent_status') updateAgentStatusUI(data);
                    else if (data.type === 'iot_update' || data.type === 'metrics_update') throttledFetch();
                } catch (err) { /* ignore */ }
            };
            ws.onclose = () => setTimeout(connectWebSocket, 5000);
        }

        function appendThought(agent, content) {
            const log = document.getElementById('thought-log');
            if (!log) return;
            const div = document.createElement('div');
            div.style.marginBottom = '8px';
            div.style.animation = 'fadeIn 0.2s ease-out';
            div.innerHTML = `<span style="color: #38bdf8; font-weight: bold;" onclick="document.getElementById('terminal-target').value='${agent}'">[${agent}]</span> <span style="color: #f1f5f9;">${content}</span>`;
            log.appendChild(div);
            log.scrollTop = log.scrollHeight;
        }

        // ============ METRICS ============
        let lastFetch = 0;
        let fetchInProgress = false;

        function throttledFetch() {
            const now = Date.now();
            if (fetchInProgress || now - lastFetch < 5000) return;
            fetchMetrics();
        }

        async function fetchMetrics() {
            lastFetch = Date.now();
            fetchInProgress = true;
            try {
                const res = await fetch('/api/v1/admin/dashboard/metrics');
                const data = await res.json();
                document.getElementById('raw-metrics').textContent = JSON.stringify(data, null, 2);
                updateMetricsGrid(data);
                updatePlatformSummary(data);
                
                // Update lattice counts
                const l2 = document.getElementById('layer2-count');
                const l3 = document.getElementById('layer3-count');
                const l2c = document.getElementById('layer2-card-count');
                const l3c = document.getElementById('layer3-card-count');
                if (l2) l2.textContent = data.memories?.total || 0;
                if (l3) l3.textContent = data.system?.vector_index_size || 0;
                if (l2c) l2c.textContent = data.memories?.total || 0;
                if (l3c) l3c.textContent = data.system?.vector_index_size || 0;
                
                // Update bar chart
                const l1 = data.memories?.total || 0;
                const l2v = data.memories?.total || 0;
                const l3v = data.system?.vector_index_size || 0;
                const total = (l1 + l2v + l3v) || 1;
                document.getElementById('bar-l1').style.width = ((l1 / total) * 100) + '%';
                document.getElementById('bar-l2').style.width = ((l2v / total) * 100) + '%';
                document.getElementById('bar-l3').style.width = ((l3v / total) * 100) + '%';
            } catch (e) { console.error('Fetch Metrics Error:', e); }
            finally { fetchInProgress = false; }
        }

        function updateMetricsGrid(data) {
            const grid = document.getElementById('metrics-grid');
            grid.innerHTML = `
                <div class="card"><div class="metric-label"><i class="fas fa-users"></i> Users</div><div class="metric-value">${data.users?.total || 0}</div></div>
                <div class="card"><div class="metric-label"><i class="fas fa-brain"></i> Memories</div><div class="metric-value">${data.memories?.total || 0}</div></div>
                <div class="card"><div class="metric-label">Ollama</div><div class="metric-value" style="font-size:20px;">${data.ai?.ollama_status || 'unknown'}</div></div>
                <div class="card"><div class="metric-label">Vector Index</div><div class="metric-value">${data.system?.vector_index_size || 0}</div></div>
                <div class="card"><div class="metric-label">Active Sessions</div><div class="metric-value">${data.sessions?.active || 0}</div></div>
                <div class="card"><div class="metric-label">Active IoT</div><div class="metric-value">${data.iot?.active_count || 0}</div></div>
                <div class="card"><div class="metric-label">IoT Telemetry</div><div class="metric-value">${data.iot?.data_points_today || 0}</div></div>
                <div class="card"><div class="metric-label">Legal Matters</div><div class="metric-value" style="color:var(--accent);">${data.legal?.active_matters || 0}</div></div>
            `;
        }

        function updatePlatformSummary(data) {
            fetchPacksSummary();
        }

        // ============ PACKS ============
        async function fetchPacks() {
            try {
                const res = await fetch('/api/v1/packs/');
                const data = await res.json();
                const grid = document.getElementById('packs-grid');
                if (data.packs && data.packs.length > 0) {
                    grid.innerHTML = data.packs.map(p => `
                        <div class="pack-card">
                            <div class="flex-between">
                                <span class="pack-name">${p.name}</span>
                                <span class="tag ${p.is_active ? 'tag-success' : ''}">${p.is_active ? 'Active' : 'Inactive'}</span>
                            </div>
                            <div class="pack-stats">Domain: ${p.domain} | Version: ${p.version}</div>
                            <div class="pack-stats" style="font-size:10px; color:#64748b;">${p.description ? p.description.slice(0, 80) + '...' : ''}</div>
                        </div>
                    `).join('');
                } else {
                    grid.innerHTML = '<div class="card"><div class="metric-label">No packs installed</div></div>';
                }
            } catch (e) { console.error('Error fetching packs:', e); }
        }

        async function fetchPacksSummary() {
            try {
                const res = await fetch('/api/v1/packs/');
                const data = await res.json();
                if (data.packs) {
                    document.getElementById('domain-count').textContent = data.packs.length;
                }
            } catch (e) { /* silent fail */ }
        }

        async function installPack() {
            const fileInput = document.getElementById('pack-file-input');
            const status = document.getElementById('pack-install-status');
            const file = fileInput.files[0];
            if (!file) { showToast('Please select a YAML file', 'error'); return; }
            
            status.textContent = 'Installing...';
            try {
                const formData = new FormData();
                formData.append('file', file);
                const res = await fetch('/api/v1/packs/install', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                if (res.ok) {
                    status.textContent = '✅ ' + (data.message || 'Installed successfully');
                    showToast('Pack installed: ' + (data.name || ''), 'success');
                    fetchPacks();
                } else {
                    status.textContent = '❌ Error: ' + (data.detail || 'Unknown error');
                    showToast('Installation failed', 'error');
                }
            } catch (e) {
                status.textContent = '❌ Error: ' + e.message;
                showToast('Installation failed', 'error');
            }
        }

        // ============ MODELS ============
        async function fetchInstalledModels() {
            try {
                const res = await fetch('/api/v1/admin/dashboard/models');
                const data = await res.json();
                const list = document.getElementById('models-list');
                if (data.models && data.models.length > 0) {
                    list.innerHTML = data.models.map(m => `
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px; background: #020617; border: 1px solid var(--border); border-radius: 8px;">
                            <div>
                                <div style="font-weight: 700; color: var(--accent);">${m.name}</div>
                                <div style="font-size: 11px; color: #64748b;">Size: ${(m.size / (1024*1024*1024)).toFixed(2)} GB</div>
                            </div>
                            <button class="refresh-btn" style="color: #f87171; border-color: #f87171; padding: 4px 10px; font-size: 11px;" onclick="deleteModel('${m.name}')">Delete</button>
                        </div>
                    `).join('');
                } else {
                    list.innerHTML = '<div class="metric-label">No models installed.</div>';
                }
            } catch (e) {
                list.innerHTML = '<div class="metric-label">Error loading models</div>';
            }
        }

        async function triggerModelPull() {
            const input = document.getElementById('new-model-input');
            const status = document.getElementById('pull-status');
            const name = input.value.trim();
            if (!name) { showToast('Enter a model name', 'error'); return; }
            
            status.textContent = 'Pulling ' + name + '...';
            showToast('Pulling ' + name, 'info');
            try {
                const res = await fetch('/api/v1/admin/dashboard/models/pull', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({name})
                });
                const reader = res.body.getReader();
                while (true) {
                    const {value, done} = await reader.read();
                    if (done) break;
                    status.textContent += new TextDecoder().decode(value);
                    status.scrollTop = status.scrollHeight;
                }
                showToast(name + ' pull complete', 'success');
                fetchInstalledModels();
            } catch (e) {
                status.textContent = '❌ Error: ' + e.message;
                showToast('Pull failed', 'error');
            }
        }

        async function deleteModel(name) {
            if (!confirm('Delete ' + name + '?')) return;
            try {
                await fetch(`/api/v1/admin/dashboard/models/${name}`, {method: 'DELETE'});
                showToast('Deleted ' + name, 'info');
                fetchInstalledModels();
            } catch (e) {
                showToast('Delete failed: ' + e.message, 'error');
            }
        }

        // ============ MCP ============
        async function fetchMcpRegistry() {
            try {
                const res = await fetch('/api/v1/admin/dashboard/mcp/registry');
                const data = await res.json();
                document.getElementById('mcp-servers-list').innerHTML = data.servers?.map(s => `
                    <div class="stat-row"><span>${s.name}</span><span class="tag tag-success">${s.status}</span></div>
                `).join('') || 'None';
                document.getElementById('mcp-tools-list').innerHTML = data.tools?.map(t => `
                    <div style="padding:8px; background:#020617; border-radius:4px; margin-bottom:4px;">
                        <b>${t.name}</b><br><span style="font-size:11px; color:#94a3b8;">${t.description}</span>
                    </div>
                `).join('') || 'None';
            } catch (e) {
                document.getElementById('mcp-servers-list').innerHTML = 'Error loading MCP registry';
            }
        }

        async function executeMcpTest() {
            const tool = document.getElementById('mcp-test-tool').value;
            const argsStr = document.getElementById('mcp-test-args').value;
            const output = document.getElementById('mcp-test-output');
            output.style.display = 'block';
            output.textContent = 'Running...';
            try {
                const res = await fetch(`/api/v1/mcp/tools/call/${tool}`, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: argsStr || '{}'
                });
                const data = await res.json();
                output.textContent = JSON.stringify(data, null, 2);
                showToast('Tool executed', 'success');
            } catch (e) {
                output.textContent = 'Error: ' + e.message;
                showToast('Execution failed', 'error');
            }
        }

        // ============ TIMELINE ============
        async function listEvents() {
            try {
                const res = await fetch('/api/v1/behaviour/events?limit=10');
                const data = await res.json();
                const container = document.getElementById('timeline-list');
                if (data && data.length > 0) {
                    container.innerHTML = data.map(e => `
                        <div class="stat-row" style="cursor:pointer;" onclick="document.getElementById('timeline-event-id').value=${e.id};fetchTimeline();">
                            <span>ID: ${e.id}</span>
                            <span style="color:#94a3b8;">${e.event_type}</span>
                            <span class="tag ${e.outcome === 'success' ? 'tag-success' : 'tag-danger'}">${e.decision}</span>
                            <span style="color:#64748b; font-size:11px;">${new Date(e.timestamp).toLocaleTimeString()}</span>
                        </div>
                    `).join('');
                } else {
                    container.innerHTML = '<div class="metric-label">No events found. Create some first.</div>';
                }
            } catch (e) {
                document.getElementById('timeline-list').innerHTML = '<div class="metric-label">No events found</div>';
            }
        }

        async function fetchTimeline() {
            const eventId = document.getElementById('timeline-event-id').value;
            if (!eventId) { showToast('Enter an Event ID', 'error'); return; }
            
            const container = document.getElementById('timeline-list');
            container.innerHTML = '<div class="metric-label">Loading timeline...</div>';
            try {
                const res = await fetch(`/api/v1/timeline/${eventId}`);
                if (res.status === 404) {
                    container.innerHTML = '<div class="metric-label" style="color:#f87171;">Event not found</div>';
                    return;
                }
                const data = await res.json();
                if (data.timeline && data.timeline.length > 0) {
                    container.innerHTML = `
                        <div style="margin-bottom:15px; padding:10px; background:#020617; border-radius:8px;">
                            <span style="color:#94a3b8;">Event: ${data.event_type}</span>
                            <span class="tag tag-success" style="margin-left:10px;">${data.decision}</span>
                        </div>
                        ${data.timeline.map(step => `
                            <div class="stat-row" style="border-left: 3px solid ${step.type === 'audit' ? '#34d399' : step.type === 'ai_recommendation' ? '#fbbf24' : '#38bdf8'}; padding-left:12px;">
                                <span><span style="font-weight:700; color:${step.type === 'audit' ? '#34d399' : step.type === 'ai_recommendation' ? '#fbbf24' : '#38bdf8'};">${step.step}.</span> ${step.label}</span>
                                <span style="font-size:12px; color:#94a3b8;">${step.description}</span>
                            </div>
                        `).join('')}
                    `;
                } else {
                    container.innerHTML = '<div class="metric-label">No timeline data for this event</div>';
                }
            } catch (e) {
                container.innerHTML = '<div class="metric-label" style="color:#f87171;">Error loading timeline</div>';
            }
        }

        // ============ REPLAY ============
        async function replayDecision() {
            const eventId = document.getElementById('replay-event-id').value;
            if (!eventId) { showToast('Enter an Event ID', 'error'); return; }
            
            const resultDiv = document.getElementById('replay-result');
            const output = document.getElementById('replay-output');
            resultDiv.style.display = 'block';
            output.textContent = 'Replaying...';
            
            try {
                const res = await fetch(`/api/v1/timeline/replay/${eventId}`);
                const data = await res.json();
                output.textContent = JSON.stringify(data, null, 2);
                showToast('Replay complete', 'success');
            } catch (e) {
                output.textContent = 'Error: ' + e.message;
                showToast('Replay failed', 'error');
            }
        }

        let currentReplaySteps = [];
        let currentReplayIndex = 0;

        function replaySpeed(speed) {
            replaySpeed = speed;
            document.getElementById('replay-speed-label').textContent = `Speed: ${speed}x`;
        }

        // ============ TRENDS ============
        async function fetchTrends() {
            const domain = document.getElementById('trend-domain').value;
            const days = document.getElementById('trend-days').value || 30;
            const result = document.getElementById('trend-result');
            result.innerHTML = '<div class="metric-label">Analyzing...</div>';
            try {
                const res = await fetch(`/api/v1/timeline/trends/${domain}?days=${days}`);
                const data = await res.json();
                if (data.error) {
                    result.innerHTML = `<div class="metric-label" style="color:#f87171;">${data.error}</div>`;
                    return;
                }
                result.innerHTML = `
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 15px;">
                        <div><div class="metric-label">Events</div><div style="font-size:24px; font-weight:700;">${data.total_events || 0}</div></div>
                        <div><div class="metric-label">Avg Confidence</div><div style="font-size:24px; font-weight:700; color:${(data.average_confidence||0) > 0.8 ? '#34d399' : '#fbbf24'}">${((data.average_confidence||0)*100).toFixed(1)}%</div></div>
                        <div><div class="metric-label">Trend</div><div style="font-size:24px; font-weight:700; color:${data.trend === 'improving' ? '#34d399' : data.trend === 'stable' ? '#fbbf24' : '#f87171'}">${data.trend === 'improving' ? '📈 Improving' : data.trend === 'stable' ? '➡️ Stable' : '📉 Declining'}</div></div>
                    </div>
                    <div style="margin-top: 15px; display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <div><div class="metric-label">Decisions</div><div style="font-size:14px;">${Object.entries(data.decision_distribution||{}).map(([k,v]) => `${k}: ${v}`).join(' | ')}</div></div>
                        <div><div class="metric-label">Outcomes</div><div style="font-size:14px;">${Object.entries(data.outcome_distribution||{}).map(([k,v]) => `${k}: ${v}`).join(' | ')}</div></div>
                    </div>
                `;
                showToast('Trend analysis complete', 'success');
            } catch (e) {
                result.innerHTML = `<div class="metric-label" style="color:#f87171;">Error: ${e.message}</div>`;
            }
        }

        // ============ AGENTS ============
        async function fetchAgentStatus() {
            try {
                const [loadRes, empathyRes, hitlRes, bbRes, traceRes] = await Promise.all([
                    fetch('/api/v1/admin/dashboard/cognitive-load'),
                    fetch('/api/v1/admin/dashboard/empathy/status'),
                    fetch('/api/v1/admin/dashboard/hitl/pending'),
                    fetch('/api/v1/admin/dashboard/blackboard/snapshot'),
                    fetch('/api/v1/admin/dashboard/swarm/negotiation-trace')
                ]);
                const load = await loadRes.json();
                const empathy = await empathyRes.json();
                const hitl = await hitlRes.json();
                const bb = await bbRes.json();
                const trace = await traceRes.json();

                // Agent status
                let agentHtml = `<div class="stat-row"><span>Active Tasks</span><span>${load.active_tasks || 0}</span></div>`;
                for (const [name, count] of Object.entries(load.agent_activity || {})) {
                    const isActive = count === 1 || count === 'active' || count === true;
                    agentHtml += `<div class="stat-row"><span>${name} Agent</span><span class="tag ${isActive ? 'tag-success' : ''}">${isActive ? 'ACTIVE' : 'IDLE'}</span></div>`;
                }
                document.getElementById('agent-load-stats').innerHTML = agentHtml;

                // Empathy
                document.getElementById('empathy-stats').innerHTML = `
                    <div class="stat-row"><span>Mood</span><span>${empathy.mood || 'Calm'}</span></div>
                    <div class="stat-row"><span>Tone</span><span>${empathy.tone || 'Supportive'}</span></div>
                `;

                // Blackboard
                const bbEl = document.getElementById('blackboard-feed');
                const bbEntries = Object.entries(bb.current_state || {});
                bbEl.innerHTML = bbEntries.length ? bbEntries.map(([agent, entry]) => `
                    <div class="stat-row" style="flex-direction:column; align-items:flex-start;">
                        <div class="flex-between" style="width:100%;"><b>${agent.toUpperCase()}</b> <small>${new Date(entry.timestamp).toLocaleTimeString()}</small></div>
                        <div style="font-size:12px; color: #94a3b8;">${JSON.stringify(entry.data)}</div>
                    </div>
                `).join('') : 'No active insights.';

                // HITL
                const hitlEl = document.getElementById('hitl-list') || document.getElementById('hitl-list');
                if (hitlEl && hitl.length > 0) {
                    hitlEl.innerHTML = hitl.map(h => `
                        <div class="stat-row" style="flex-direction:column; align-items:flex-start; border:1px solid var(--border); border-radius:8px; padding:10px; margin-bottom:5px;">
                            <div class="flex-between" style="width:100%;">
                                <b>${h.agent_type}</b>
                                <small>${new Date(h.timestamp).toLocaleTimeString()}</small>
                            </div>
                            <div style="font-size:13px; margin:5px 0;">${h.query}</div>
                            <div style="display:flex; gap:10px;">
                                <button class="btn" style="padding:2px 8px; font-size:11px;" onclick="approveAction('${h.id}')">Approve</button>
                                <button class="btn" style="padding:2px 8px; font-size:11px; background:#7f1d1d;" onclick="denyAction('${h.id}')">Deny</button>
                                <button class="btn" style="padding:2px 8px; font-size:11px; background:#334155;" onclick="showHitlDetails('${h.id}')">Details</button>
                            </div>
                        </div>
                    `).join('');
                } else if (hitlEl) {
                    hitlEl.innerHTML = 'No pending actions.';
                }

                // CoT Graph
                const container = document.getElementById('mermaid-graph-container');
                if (trace.sequence && trace.sequence.length > 0) {
                    let graphDef = 'graph LR\\n';
                    graphDef += 'classDef agentNode fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#fff;\\n';
                    graphDef += 'classDef bbNode fill:#0f172a,stroke:#a855f7,stroke-width:2px,stroke-dasharray:5 5;\\n';
                    
                    trace.sequence.forEach(step => {
                        const fromId = step.agent.replace(/[^a-zA-Z0-9]/g, '');
                        const toId = step.to.replace(/[^a-zA-Z0-9]/g, '');
                        graphDef += `${fromId}("${step.agent}") -- "${step.action}" --> ${toId}("${step.to}")\\n`;
                        graphDef += `class ${fromId} agentNode;\\n`;
                        if (toId === 'Blackboard') graphDef += `class ${toId} bbNode;\\n`;
                    });
                    container.innerHTML = `<div class="mermaid">${graphDef}</div>`;
                    try { mermaid.init(undefined, container.querySelectorAll('.mermaid')); } catch(e) {}
                } else {
                    container.innerHTML = `
                        <div style="text-align:center; color:#64748b;">
                            <div style="font-size:48px; margin-bottom:10px;">🔄</div>
                            <div>Awaiting negotiation signal...</div>
                            <div style="font-size:11px; margin-top:5px;">Send a query to the swarm to see the CoT graph</div>
                        </div>
                    `;
                }
            } catch (e) { console.error('Agent status error:', e); }
        }

        // ============ SWARM ============
        async function triggerSwarm() {
            const input = document.getElementById('swarm-query-input');
            const query = input.value.trim();
            if (!query) { showToast('Please enter a query', 'error'); return; }
            
            showToast('Igniting swarm...', 'info');
            try {
                const res = await fetch('/api/v1/admin/dashboard/swarm/trigger', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ query })
                });
                const data = await res.json();
                if (data.status === 'swarm_completed') {
                    showToast('Swarm completed!', 'success');
                    appendThought('Orchestrator', data.result || 'Query processed');
                } else {
                    showToast('Swarm triggered', 'info');
                }
                input.value = '';
                setTimeout(fetchAgentStatus, 2000);
            } catch (e) {
                showToast('Error: ' + e.message, 'error');
            }
        }

        // ============ GOVERNANCE ============
        async function fetchGovernanceLogs() {
            try {
                const res = await fetch('/api/v1/admin/dashboard/governance/logs?limit=20');
                const data = await res.json();
                const container = document.getElementById('audit-container');
                if (data.logs && data.logs.length > 0) {
                    container.innerHTML = data.logs.map(l => `
                        <div style="padding:8px 0; border-bottom:1px solid var(--border);">
                            <div class="flex-between">
                                <span style="font-size:13px;">${l.query || 'No query'}</span>
                                <span class="tag ${l.hitl ? 'tag-success' : ''}">${l.hitl ? 'HITL' : 'AUTO'}</span>
                            </div>
                            <div style="font-size:11px; color:#64748b;">
                                Receipt: ${l.receipt || 'N/A'} | ${new Date(l.timestamp).toLocaleString()}
                            </div>
                        </div>
                    `).join('');
                } else {
                    container.innerHTML = '<div class="metric-label">No governance logs found</div>';
                }
            } catch (e) {
                document.getElementById('audit-container').innerHTML = '<div class="metric-label">Error loading governance logs</div>';
            }
        }

        async function toggleVeriLinkMode() {
            try {
                const res = await fetch('/api/v1/admin/dashboard/governance/toggle-offline', {method: 'POST'});
                const data = await res.json();
                showToast(data.offline_mode ? 'VeriLink offline' : 'VeriLink online', 'info');
                document.getElementById('verilink-desc').textContent = data.offline_mode ? 'VeriLink connection suppressed' : 'VeriLink active';
            } catch (e) {
                showToast('Error toggling VeriLink', 'error');
            }
        }

        // ============ SECURITY ============
        async function fetchSecurityStatus() {
            const container = document.getElementById('security-status-card');
            try {
                const res = await fetch('/api/v1/admin/dashboard/metrics');
                const data = await res.json();
                container.innerHTML = `
                    <div class="stat-row"><span>Encryption</span><span style="color:#34d399;">✅ ${data.security?.encryption || 'Active'}</span></div>
                    <div class="stat-row"><span>Tokenization</span><span style="color:#34d399;">✅ ${data.security?.tokenization || 'Active'}</span></div>
                    <div class="stat-row"><span>Sovereign Mode</span><span style="color:#34d399;">✅ Local-First</span></div>
                    <div class="stat-row"><span>VeriLink</span><span style="color:${data.ai?.verilink_status === 'active' ? '#34d399' : '#fbbf24'};">${data.ai?.verilink_status || 'Not Installed'}</span></div>
                `;
            } catch (e) {
                container.innerHTML = '<div class="metric-label">Error loading security status</div>';
            }
        }

        // ============ LEARNING ============
        async function fetchLearningConfig() {
            try {
                const res = await fetch('/api/v1/admin/dashboard/learning/config');
                const data = await res.json();
                document.getElementById('input-batch-size').value = data.batch_size || 10;
                document.getElementById('input-interval').value = data.interval_hours || 1.0;
            } catch (e) { /* silent fail */ }
        }

        async function saveLearningConfig() {
            const batch_size = document.getElementById('input-batch-size').value;
            const interval_hours = document.getElementById('input-interval').value;
            try {
                await fetch('/api/v1/admin/dashboard/learning/config', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({batch_size, interval_hours})
                });
                showToast('Learning config saved', 'success');
            } catch (e) {
                showToast('Error saving config', 'error');
            }
        }

        async function triggerLearning() {
            try {
                await fetch('/api/v1/admin/dashboard/learning/trigger', {method: 'POST'});
                showToast('Crystallization cycle triggered', 'success');
            } catch (e) {
                showToast('Error: ' + e.message, 'error');
            }
        }

        // ============ SIMULATION ============
        async function toggleSimulation() {
            const btn = document.getElementById('sim-btn');
            try {
                const res = await fetch('/api/v1/admin/dashboard/system/simulate-iot', {method: 'POST'});
                const data = await res.json();
                if (data.status === 'started') {
                    btn.innerHTML = '<i class="fas fa-stop-circle"></i> Terminate Simulation';
                    btn.style.background = '#7f1d1d';
                    showToast('IoT simulation active', 'success');
                } else {
                    btn.innerHTML = '<i class="fas fa-bolt"></i> Ignite IoT Simulation';
                    btn.style.background = '#38bdf8';
                    showToast('Simulation stopped', 'info');
                }
            } catch (e) {
                showToast('Error: ' + e.message, 'error');
            }
        }

        // ============ HITL ============
        async function approveAction(id) {
            try {
                await fetch(`/api/v1/admin/dashboard/hitl/${id}/approve`, {method: 'POST'});
                showToast('Action approved', 'success');
                fetchAgentStatus();
            } catch (e) {
                showToast('Error approving', 'error');
            }
        }

        async function denyAction(id) {
            try {
                await fetch(`/api/v1/admin/dashboard/hitl/${id}/deny`, {method: 'POST'});
                showToast('Action denied', 'info');
                fetchAgentStatus();
            } catch (e) {
                showToast('Error denying', 'error');
            }
        }

        function showHitlDetails(id) {
            const modal = document.getElementById('details-modal');
            const body = document.getElementById('modal-body');
            document.getElementById('modal-title').textContent = 'HITL Action Details';
            body.innerHTML = `<div class="metric-label">Loading...</div>`;
            modal.style.display = 'block';
            // Fetch details
            fetch(`/api/v1/admin/dashboard/hitl/${id}/explain`, {method: 'POST'})
                .then(res => res.json())
                .then(data => {
                    body.innerHTML = `
                        <div style="margin-bottom:15px;">
                            <div class="metric-label">Explanation</div>
                            <div style="background:#020617; padding:15px; border-radius:8px; margin-top:5px;">${data.explanation || 'No explanation available'}</div>
                        </div>
                        <button class="btn" onclick="closeModal()">Close</button>
                    `;
                })
                .catch(() => {
                    body.innerHTML = `<div class="metric-label" style="color:#f87171;">Error loading details</div>`;
                });
        }

        function closeModal() {
            document.getElementById('details-modal').style.display = 'none';
        }
        window.onclick = function(event) {
            if (event.target === document.getElementById('details-modal')) closeModal();
        };

        // ============ LOGOUT ============
        async function logout() {
            await fetch('/api/v1/auth/logout', {method: 'POST'});
            window.location.href = '/login';
        }

        // ============ INIT ============
        fetchMetrics();
        connectWebSocket();
        setInterval(fetchMetrics, 60000);
        setInterval(fetchPacksSummary, 30000);
        setInterval(fetchAgentStatus, 10000);
    </script>
</body>
</html>
"""
