# ============================================
# PersonaVault Backend Configuration Template
# ============================================
# Instructions:
# 1. Copy this file to ./backend/.env
# 2. Replace placeholder values with your actual credentials
# 3. For security: never commit .env to version control
#
# Generate secure keys:
#   python -c 'import secrets; print(secrets.token_hex(32))'
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
# ============================================

# ---------- Environment ----------
APP_ENV=development
# Options: development, staging, production
INFRA_MODE=converged
# Options: converged (SQL-only), distributed (SQL+Weaviate+Neo4j)
CONNECTIVITY_MODE=LOCAL
# Options: LOCAL, CLOUD, HYBRID
IS_AIR_GAPPED=false
# Options: true, false

# ---------- Networking ----------
# Used for governance callbacks and dashboard links
BASE_URL=http://localhost:8000

# ---------- CORS ----------
# Comma-separated list of allowed origins. In development you can set CORS_ALLOW_ALL=true.
# ALLOWED_ORIGINS=https://app.personavault.com,https://admin.personavault.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
# Set to true ONLY in development (APP_ENV must also be "development")
CORS_ALLOW_ALL=false

# ---------- Security ----------
SECRET_KEY=your_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: AES-128 key for field-level encryption
ENCRYPTION_KEY=your_encryption_key_here

# ---------- Metrics Endpoint Protection ----------
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
# Leave empty to rely on IP allowlist only (METRICS_ALLOWED_IPS)
METRICS_TOKEN=your_metrics_token_here
# Comma-separated IPs that can scrape /metrics without a token (e.g. Prometheus server)
METRICS_ALLOWED_IPS=127.0.0.1,::1

# ---------- AI Services ----------
OLLAMA_BASE_URL=http://localhost:11434
# Base model for general generation
OLLAMA_BASE_MODEL=llama3
# Reasoning model for Chain-of-Thought & pattern extraction
OLLAMA_REASONER_MODEL=llama3:70b

# ---------- Database ----------
DATABASE_URL=postgresql+asyncpg://personavault:personavault@localhost:5432/personavault
# DATABASE_URL=sqlite+aiosqlite:///./storage/memory_db/personavault.db

# ---------- Distributed Services ----------
# Redis for rate limiting (required for horizontal scaling)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_WINDOW=60
MAX_REQUESTS_PER_WINDOW=100

# ---------- Relational Memory ----------
# Neo4j configuration (fail-soft if unavailable)
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ---------- Governance ----------
# VeriLink offline mode for air-gapped deployments
VERILINK_OFFLINE_MODE=false

# ---------- Logging ----------
LOG_FILE_PATH=storage/logs/uvicorn.log